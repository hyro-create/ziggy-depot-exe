# Intégrations OPTIONNELLES de Ziggy (laisse vide pour désactiver).
# La clé Gemini ne se met PAS ici : elle s'ajoute dans l'application (⚙ Paramètres → Gemini) et est stockée chiffrée.

# Dossiers supplémentaires accessibles, séparés par des virgules (ex: D:\Projets,E:\Photos)
ZIGGY_EXTRA_DIRS=
# Fuseau horaire pour l'agenda
TIMEZONE=Europe/Paris
# ID d'application Microsoft (Outlook, OneDrive, To Do) — voir README
MS_CLIENT_ID=
# Todoist : Paramètres > Intégrations > Développeur > Jeton API
TODOIST_TOKEN=
# Notion : notion.so/my-integrations
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
# Spotify : developer.spotify.com/dashboard (compte Premium requis)
SPOTIFY_CLIENT_ID=
# Telegram : @BotFather > /newbot ; l'identifiant s'obtient en écrivant au bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_ID=
